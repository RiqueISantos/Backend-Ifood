# ── JWT ───────────────────────────────────────────────────────────────────
SECRET_KEY=sua_chave_secreta_jwt
ALGORITHM=HS256
TEMPO_EXPIRACAO_MINUTOS=60

# ── Flask ─────────────────────────────────────────────────────────────────
SECRET_KEY_FLASK=sua_chave_secreta_flask

# ── Banco de dados ────────────────────────────────────────────────────────
# Ao rodar com Docker, esta variável é sobrescrita pelo docker-compose.yml
# automaticamente. Só altere se estiver rodando o backend fora do Docker.
DATABASE_URL=postgresql://postgres:password123@localhost:5432/db_ifood

# ── Google OAuth ──────────────────────────────────────────────────────────
CLIENT_ID_GOOGLE=seu_client_id_google
SECRET_KEY_GOOGLE=seu_secret_google

# ── Twilio (SMS / WhatsApp) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_TEMPLATE_SID=seu_template_sid
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
